#!/bin/sh
set -e

# Git passes ref update data to pre-push on stdin. Detach child commands from that
# stream so test/build tools cannot keep the hook hanging by inheriting the pipe.
exec </dev/null

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "Running pre-push checks..."

echo "Backend: ruff + tests"
(
    cd apps/python
    uv run ruff check .
    uv run ruff format --check .
    uv run pytest tests/ -v
)

echo "Frontend: lint + tests + build"
(
    cd apps/nextjs
    npm run lint
    npm test
    npm run build
)

echo "Pre-push checks passed."
